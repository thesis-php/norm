{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "testFramework": "testo",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "tmpDir": "var",
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,
    },
}
